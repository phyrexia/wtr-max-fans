FIN_LABORABLE = dt.time(9, 0)
FIN_FESTIVO = dt.time(10, 0)


@dataclass
class Festivos:
    fechas: frozenset[dt.date]
    anios: frozenset[int]


def leer_festivos(ruta: Path) -> Festivos | None:
    """Formato: `# cubre: 2026 2027` y una línea `AAAA-MM-DD nombre` por festivo.

    Devuelve None si el archivo falta o no es coherente (año sin cubrir, cubierto sin fechas,
    fecha inválida): quien llama lo trata como «no se puede decidir».
    """
    try:
        texto = ruta.read_text(encoding="utf-8")
    except OSError:
        return None
    anios: set[int] | None = None
    fechas: set[dt.date] = set()
    for linea in texto.splitlines():
        s = linea.strip()
        m = re.fullmatch(r"#\s*cubre:\s*((?:\d{4}\s*)+)", s)
        if m:
            if anios is not None:
                return None
            anios = {int(a) for a in m.group(1).split()}
            continue
        if not s or s.startswith("#"):
            continue
        m = re.match(r"(\d{4}-\d{2}-\d{2})(?:\s|$)", s)
        if not m:
            return None
        try:
            fechas.add(dt.date.fromisoformat(m.group(1)))
        except ValueError:
            return None
    if not anios:
        return None
    if any(f.year not in anios for f in fechas):
        return None
    if any(not any(f.year == a for f in fechas) for a in anios):
        return None
    return Festivos(frozenset(fechas), frozenset(anios))


# --- decisión -----------------------------------------------------------------------------------

@dataclass(frozen=True)
class Decision:
    perfil: str
    motivo: str
    festivos_cubiertos: bool


def decidir(ahora: dt.datetime, festivos: Festivos | None, perfil_diurno: str) -> Decision:
    """Perfil para el instante `ahora` (con zona horaria). Función pura: la prueban los tests."""
    if ahora.tzinfo is None:
        raise ValueError("ahora debe llevar zona horaria")
    local = ahora.astimezone(ZONA)
    hoy, hora = local.date(), local.time()
    cubiertos = festivos is not None and hoy.year in festivos.anios
    if hora >= INICIO_NOCHE:
        return Decision("quiet", "noche", cubiertos)
    if hoy.weekday() >= 5:
        fin, tipo = FIN_FESTIVO, "fin de semana"
    elif not cubiertos:
        fin, tipo = FIN_FESTIVO, "festivos sin cubrir: se asume festivo"
    elif hoy in festivos.fechas:
        fin, tipo = FIN_FESTIVO, "festivo"
    else:
        fin, tipo = FIN_LABORABLE, "laborable"
    if hora < fin:
        return Decision("quiet", f"madrugada, {tipo} (hasta las {fin:%H:%M})", cubiertos)
    return Decision(perfil_diurno, f"día, {tipo}", cubiertos)


