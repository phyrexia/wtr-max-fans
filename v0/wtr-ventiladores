    "DISCOS": "",
}
RANGOS = {
    "CICLO_S": (10, 120), "T_PISO_C": (20, 70), "T_SILENCIO_C": (20, 70), "T_CONVERGE_C": (20, 70),
    "T_MAX_C": (20, 70), "PASO_SUBIDA": (1, 255), "PASO_BAJADA": (1, 255), "BANDA_MUERTA": (0, 60),
